{
    "manifest_version": 3,
    "name": "Metafreze",
    "version": "1.0.0",
    "description": "Minimal inline translation extension",
    
    "icons": {
      "16": "assets/logo16.png",
      "48": "assets/logo.png",
      "128": "assets/logo.png"
    },
    "background": {
        "service_worker": "service-worker.js"
      },

    "permissions": ["scripting", "activeTab","storage"],
    "content_scripts": [
    {
      "js": [
        "content-script.js"
      ],
      "css": [
        "style.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]

    
  }