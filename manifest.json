{
    "manifest_version": 3,
    "name": "Metafreze",
    "version": "1.0.0",
    "description": "Minimal inline translation extension",
    "background": {
        "service_worker": "service-worker.js"
      },

    "permissions": ["scripting", "activeTab","storage"],
    "content_scripts": [
    {
      "js": [
        "content-script.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]

    
  }